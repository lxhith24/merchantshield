# Anthropic API key — required for document intelligence + explanation generation.
# Without it, MerchantShield runs in HEURISTIC_ONLY mode (rules still work, no LLM).
ANTHROPIC_API_KEY=

# Model used for document vision analysis and reviewer explanations
MERCHANTSHIELD_MODEL=claude-sonnet-4-20250514

# Database
DATABASE_URL=sqlite:///./merchantshield.db

# Upload storage
UPLOAD_DIR=./data/uploads

# Phase 3 investigator (separate from the legacy document-vision model)
MERCHANTSHIELD_INVESTIGATOR_MODEL=claude-opus-5
MERCHANTSHIELD_INVESTIGATOR_EFFORT=high

# Razorpay Partner TEST adapter (Phase 5). Left off, the simulated gateway is
# used and makes zero network calls. A live (rzp_live_...) key is refused.
RAZORPAY_PARTNER_TEST_ENABLED=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
